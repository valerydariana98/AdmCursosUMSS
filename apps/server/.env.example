# apps/server/.env
PORT=3001
DATABASE_URL=postgres://usuario:password@host:puerto/database

# Firma de los JWT de sesión (HU #27). Obligatorio: sin él el login no puede
# emitir tokens. Debe ser un valor largo y secreto.
JWT_SECRET=cambie-este-valor-por-uno-largo-y-secreto

# Solo lo usa el seed de desarrollo, para crear el grupo de prueba del docente.
# La sesión ya no depende de esto: `getCurrentTeacherForUser` resuelve el
# instructor desde el token.
CURRENT_TEACHER_ID=6

# Carpeta donde se guardan las imágenes de certificados (HU-02, HU-03) y los ZIP
# generados (HU-04). Es relativa a apps/server. Debe existir; el servidor la crea
# sola si falta, pero en producción conviene apuntarla a un volumen persistente
# para que un reinicio no borre los fondos y las firmas ya subidas.
UPLOADS_DIR=./uploads

# Prefijo con el que Express sirve esa carpeta como archivos estáticos.
UPLOADS_URL_PREFIX=/uploads