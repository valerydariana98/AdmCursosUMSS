# apps/server/.env
PORT=3001
DATABASE_URL=postgres://usuario:password@host:puerto/database

# Firma de los JWT de sesión (HU #27). Obligatorio: sin él el login no puede
# emitir tokens. Debe ser un valor largo y secreto.
JWT_SECRET=cambie-este-valor-por-uno-largo-y-secreto

# Solo lo usa el seed de desarrollo, para crear el grupo de prueba del docente.
# La sesión ya no depende de esto: `getCurrentTeacherForUser` resuelve el
# instructor desde el token. Si no se define, el grupo de prueba queda a nombre
# del DOCENTE que crea el seed (SEED_DOCENTE_*); en una base vacía conviene
# dejarlo comentado.
CURRENT_TEACHER_ID=6

# Usuarios de prueba que crea `npm run db:seed`. SOLO para local y CI.
# NUNCA definirlas en producción: la app no permite crear admins y el único
# ADMIN real lo provee el desarrollador.
# - Si faltan las variables de un rol, el seed no crea ese usuario.
# - Es idempotente: no duplica usuarios y no crea un ADMIN si ya existe uno.
# - Las contraseñas se guardan hasheadas con bcrypt.
# - El login es por USERNAME, no por email.
# SEED_ADMIN_USERNAME=admin.qa
# SEED_ADMIN_EMAIL=admin.qa@example.com
# SEED_ADMIN_PASSWORD=
# SEED_DOCENTE_USERNAME=docente.qa
# SEED_DOCENTE_EMAIL=docente.qa@example.com
# SEED_DOCENTE_PASSWORD=

# Carpeta donde se guardan las imágenes de certificados y los ZIP
# generados. Es relativa a apps/server. Debe existir; el servidor la crea
# sola si falta, pero en producción conviene apuntarla a un volumen persistente
# para que un reinicio no borre los fondos ya subidos.
UPLOADS_DIR=./uploads

# Prefijo con el que Express sirve esa carpeta como archivos estáticos.
UPLOADS_URL_PREFIX=/uploads